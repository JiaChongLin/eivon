# Eivon self-hosted configuration
EIVON_DATA_DIR=./var
# Set a random 32+ byte Fernet key before production. Leave empty for local generated key.
EIVON_SECRET_KEY=
# Optional PostgreSQL URL; empty uses SQLite for local development.
EIVON_DATABASE_URL=
# Set this before first setup, otherwise it is generated in EIVON_DATA_DIR/setup-token.
EIVON_SETUP_TOKEN=
EIVON_SECURE_COOKIES=false
# Comma-separated host[:port] allowlist for model and HTTP tool destinations.
EIVON_OUTBOUND_HOSTS=
# Trusted deployment-time Python extension modules.
EIVON_EXTENSIONS=
# Use false when running a separate worker process.
EIVON_INLINE_WORKER=true
